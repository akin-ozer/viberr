# Viberr environment configuration.
# Copy to .env for local development (.env is gitignored — never commit it).
# All variables are validated at startup by app/server/config/env.server.ts;
# the server refuses to boot with a clear message if anything is missing/invalid.

# ============ Required ============

# Signs the session cookie. Random string, at least 32 characters.
# Generate: openssl rand -base64 48
VIBERR_SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# AES-256-GCM key for encrypting stored secrets (e.g. GitHub PATs) at rest.
# Must be base64 that decodes to EXACTLY 32 bytes.
# Generate: openssl rand -base64 32
VIBERR_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ============ Optional ============

# Runtime data root: canonical project/task files, sqlite projections, run
# logs. Relative paths resolve against the working directory. Default: ./data
#VIBERR_DATA_ROOT=./data

# HTTP port for the dev server and react-router-serve. Default: 5173
#PORT=5173

# development | production | test. Default: development
#NODE_ENV=development

# Absolute public origin of the app, e.g. https://viberr.example.com. better-auth
# uses it to build OAuth callback + cookie URLs (and PR back-links). Optional in
# dev (the origin is inferred from the request); REQUIRED behind a reverse proxy
# so redirects and cookies resolve to the public host.
#BETTER_AUTH_URL=

# better-auth cookie-signing secret. Optional — defaults to VIBERR_SESSION_SECRET.
# Set it only to rotate the auth secret independently of the legacy session
# secret. Random string, at least 32 characters. Generate: openssl rand -base64 48
#BETTER_AUTH_SECRET=

# Log verbosity: debug | info | warn | error. Read directly off the environment
# by the (dependency-free) logger — NOT validated by env.server.ts.
# Default: info in production, debug otherwise.
#LOG_LEVEL=debug

# GitHub OAuth login — optional; the login button stays disabled when unset.
#GITHUB_OAUTH_CLIENT_ID=
#GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth login — optional; the login button stays disabled when unset.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=

# Seed admin: created automatically at boot when the users table is EMPTY.
# Without these, the default admin is arda@viberr.dev with a random one-time
# password printed ONCE to stdout (marked "VIBERR BOOTSTRAP ADMIN"); that
# account must set a new password at first sign-in.
# Password must be at least 8 characters.
#VIBERR_SEED_ADMIN_EMAIL=admin@example.com
#VIBERR_SEED_ADMIN_PASSWORD=change-me-please

# ---------------------------------------------------------------------------
# Runtime backends — OPTIONAL. Without a usable credential, a requested run uses
# the clearly labelled simulated demo engine. Simulated rows never count as
# delivery, reviewer approval, health, or completion evidence. Configure a
# credential below to run a real agent through the official SDK.
#
#   Claude (via @anthropic-ai/claude-agent-sdk) — ANY of:
#     - an API key, OR
#     - a long-lived OAuth token from `claude setup-token` (Claude subscription), OR
#     - VIBERR_CLAUDE_USE_CLI_AUTH=1 when the host's `claude` CLI is already
#       logged in (the SDK then uses that ambient/keychain auth — no key needed).
#ANTHROPIC_API_KEY=sk-ant-...
#CLAUDE_CODE_OAUTH_TOKEN=
#VIBERR_CLAUDE_USE_CLI_AUTH=1
#   Claude Agent SDK config/session dir. Sessions live at
#   $CLAUDE_CONFIG_DIR/projects/<cwd>/<id>.jsonl — default it under the data
#   volume so a resumed session (commenting an agent) survives restarts.
#CLAUDE_CONFIG_DIR=/data/runtimes/claude-home
#
#   Codex (via @openai/codex-sdk) — SUBSCRIPTION options:
#     - ChatGPT Business/Enterprise automation token: CODEX_ACCESS_TOKEN. This
#       uses ChatGPT workspace entitlements, NOT Platform API billing, and needs
#       no host ~/.codex mount. Create it in ChatGPT Workspace Access tokens.
#     - Other ChatGPT plans: run `codex login`, copy ONLY ~/.codex/auth.json to
#       ./docker-data/runtimes/codex-home/auth.json, then set
#       VIBERR_CODEX_USE_CLI_AUTH=1.
#       (For local non-container use, set CODEX_HOME to the login directory.)
#   Or use CODEX_API_KEY / OPENAI_API_KEY for usage-based Platform billing.
#CODEX_ACCESS_TOKEN=
#CODEX_API_KEY=...
#OPENAI_API_KEY=sk-...
#VIBERR_CODEX_USE_CLI_AUTH=1
#CODEX_HOME=/data/runtimes/codex-home
#
#   Idle (inactivity) timeout for a Codex run, in ms — the window a single
#   turn/tool may produce no event before the run is treated as hung. Read
#   directly off the environment (NOT validated by env.server.ts).
#   Default: 900000 (15 minutes).
#VIBERR_CODEX_IDLE_TIMEOUT_MS=900000
