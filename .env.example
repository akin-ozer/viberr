# Viberr environment configuration.
# Copy to .env for local development (.env is gitignored — never commit it).
# All variables are validated at startup by app/server/config/env.server.ts;
# the server refuses to boot with a clear message if anything is missing/invalid.

# ============ Required ============

# Signs the session cookie. Random string, at least 32 characters.
# Generate: openssl rand -base64 48
VIBERR_SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# AES-256-GCM key for encrypting stored secrets (e.g. GitHub PATs) at rest.
# Must be base64 that decodes to EXACTLY 32 bytes.
# Generate: openssl rand -base64 32
VIBERR_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ============ Optional ============

# Runtime data root: canonical project/task files, sqlite projections, run
# logs. Relative paths resolve against the working directory. Default: ./data
#VIBERR_DATA_ROOT=./data

# HTTP port for the dev server and react-router-serve. Default: 5173
#PORT=5173

# development | production | test. Default: development
#NODE_ENV=development

# GitHub OAuth login — optional; the login button stays disabled when unset.
#GITHUB_OAUTH_CLIENT_ID=
#GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth login — optional; the login button stays disabled when unset.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=

# Seed admin account for `npm run seed` (arrives in phase 3) — optional.
# Password must be at least 8 characters.
#VIBERR_SEED_ADMIN_EMAIL=admin@example.com
#VIBERR_SEED_ADMIN_PASSWORD=change-me-please
